    "/api/runs/{run_id}/series": {
      "get": {
        "summary": "Series",
        "operationId": "series_api_runs__run_id__series_get",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Run Id"
