  "components": {
    "schemas": {
      "EvaluationConfig": {
        "properties": {
          "frequency_hz": {
            "type": "number",
            "title": "Frequency Hz",
            "default": 50.0
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "default": 0.95
          },
          "monte_carlo_trials": {
            "type": "integer",
            "title": "Monte Carlo Trials",
            "default": 20
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "EvaluationConfig"
      },
      "ExperimentConfig": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "name": {
            "type": "string",
            "title": "Name",
            "default": "四装甲板平移与自旋"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          },
          "scene": {
            "$ref": "#/components/schemas/SceneConfig"
          },
          "observation": {
            "$ref": "#/components/schemas/ObservationConfig"
          },
          "models": {
            "items": {
              "$ref": "#/components/schemas/ModelDefinition"
            },
            "type": "array",
            "title": "Models"
          },
          "instances": {
            "items": {
              "$ref": "#/components/schemas/FilterConfig"
            },
            "type": "array",
            "title": "Instances"
          },
          "forecast": {
            "$ref": "#/components/schemas/ForecastConfig"
          },
          "evaluation": {
            "$ref": "#/components/schemas/EvaluationConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ExperimentConfig"
      },
      "FilterConfig": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ekf",
              "ukf",
              "imm"
            ],
            "title": "Kind",
            "default": "ekf"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "model_id": {
            "type": "string",
            "title": "Model Id",
            "default": "rm-cv"
          },
          "frequency_hz": {
            "type": "number",
            "title": "Frequency Hz",
            "default": 50.0
          },
          "x0": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "X0"
          },
          "p0": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "P0"
          },
          "q_scale": {
            "type": "number",
            "title": "Q Scale",
            "default": 1.0
          },
          "r_scale": {
            "type": "number",
            "title": "R Scale",
            "default": 1.0
          },
          "ukf": {
            "$ref": "#/components/schemas/UKFParameters"
          },
          "imm": {
            "$ref": "#/components/schemas/IMMConfig"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "title": "FilterConfig"
      },
      "ForecastConfig": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled",
            "default": true
          },
          "leads_s": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Leads S"
          },
          "max_step_s": {
            "type": "number",
            "title": "Max Step S",
            "default": 0.005
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ForecastConfig"
      },
      "GeometryConfig": {
        "properties": {
          "radius_a": {
            "type": "number",
            "title": "Radius A",
            "default": 0.25
          },
          "radius_b": {
            "type": "number",
            "title": "Radius B",
            "default": 0.35
          },
          "height_a": {
            "type": "number",
            "title": "Height A",
            "default": 0.2
          },
          "height_diff": {
            "type": "number",
            "title": "Height Diff",
            "default": 0.08
          },
          "reference_id": {
            "type": "integer",
            "title": "Reference Id",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "GeometryConfig"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IMMConfig": {
        "properties": {
          "models": {
            "items": {
              "$ref": "#/components/schemas/IMMModeConfig"
            },
            "type": "array",
            "title": "Models"
          },
          "probabilities": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "title": "Probabilities"
          },
          "generator": {
            "items": {
              "items": {
                "type": "number"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Generator"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IMMConfig"
      },
      "IMMModeConfig": {
        "properties": {
          "model_id": {
            "type": "string",
            "title": "Model Id",
            "default": "rm-cv"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ekf",
              "ukf"
            ],
            "title": "Kind",
            "default": "ekf"
          },
          "q_scale": {
            "type": "number",
            "title": "Q Scale",
            "default": 1.0
          },
          "r_scale": {
            "type": "number",
            "title": "R Scale",
            "default": 1.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "IMMModeConfig"
      },
      "ModelDefinition": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id",
            "default": "rm-cv"
          },
          "kind": {
            "type": "string",
            "enum": [
              "builtin",
              "python"
            ],
            "title": "Kind",
            "default": "builtin"
          },
          "builtin_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Builtin Name",
            "default": "rm_cv"
          },
          "source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source"
          },
          "params": {
            "additionalProperties": true,
            "type": "object",
            "title": "Params"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ModelDefinition"
      },
      "ModelTemplateResponse": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          }
        },
        "type": "object",
        "required": [
          "source"
        ],
        "title": "ModelTemplateResponse"
      },
      "ModelValidationIssue": {
        "properties": {
          "message": {
            "type": "string",
