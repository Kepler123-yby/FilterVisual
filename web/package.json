{
  "name": "filtervisual-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest",
    "test:e2e": "playwright test",
    "generate:api": "openapi-typescript src/api/openapi.json -o src/api/generated.d.ts",
    "format": "prettier --write src tests e2e *.ts index.html"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "monaco-editor": "0.52.2",
    "plotly.js-basic-dist-min": "3.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.0",
    "@types/plotly.js": "3.0.7",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "jsdom": "27.4.0",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
